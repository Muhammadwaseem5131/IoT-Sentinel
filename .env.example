# Infrastructure bootstrap settings only.
# AI provider keys are NEVER set here - enter them via the dashboard Settings page.
NVD_API_KEY=
SCAN_SUBNET=192.168.1.0/24
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Auto-generated on first run if missing:
SECRETS_ENCRYPTION_KEY_PATH=./.secrets.key
# Set to "true" to disable /docs + /redoc and enforce localhost-only access:
IOT_PRODUCTION=false
