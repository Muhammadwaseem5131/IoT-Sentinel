FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY .env.example ./backend/.env.example

WORKDIR /app/backend

EXPOSE 8000

# Docs/redoc stay enabled by default; set IOT_PRODUCTION=true to disable them
# and bind to localhost only. Run with --host 0.0.0.0 when intentionally
# exposing the dashboard (e.g. so the Wireless module on another host can reach it).
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
